{
	"manifest_version": 3,
	"name": "GitHub Co-Authors Generator",
	"version": "0.1.1",
	"description": "Adds an \"Add co-authors\" button to the GitHub merge box that credits PR participants, using your own GitHub authentication.",
	"minimum_chrome_version": "140",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "GitHub Co-Authors Generator settings",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"options_ui": {
		"page": "options/options.html",
		"open_in_tab": true
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": ["storage"],
	"host_permissions": ["https://api.github.com/*", "https://github.com/login/*"],
	"content_scripts": [
		{
			"matches": ["https://github.com/*"],
			"exclude_matches": ["https://github.com/login/*"],
			"js": ["content/content.js"],
			"run_at": "document_idle"
		}
	]
}
